# JWT Pizza Service production container
FROM node:22

WORKDIR /app

# Install production dependencies first so Docker can cache this layer.
COPY package*.json ./
RUN npm ci --omit=dev

# Copy the rest of the service. src/config.js is generated by the CI
# pipeline (scripts/write-ci-config.js) before the image is built.
COPY . .

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", "src/index.js", "3000"]
